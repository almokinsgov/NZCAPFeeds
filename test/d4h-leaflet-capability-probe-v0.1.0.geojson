        "iconSize": [25, 41],
        "iconAnchor": [12, 41],
        "popupAnchor": [1, -34],
        "expected": "Only works if D4H explicitly reads icon properties. GeoJSON itself cannot instantiate L.Icon"
      },
      "geometry": {"type": "Point", "coordinates": [173.2660, -35.1115]}
    },
    {
      "type": "Feature",
      "id": "P08",
