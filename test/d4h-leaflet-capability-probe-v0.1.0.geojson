        "radius": 14,
        "color": "#111111",
        "weight": 5,
        "opacity": 0.65,
        "fillColor": "#33a02c",
        "fillOpacity": 0.35,
        "expected": "Normally ignored by plain L.geoJSON unless D4H maps these properties into pointToLayer/style"
      },
      "geometry": {"type": "Point", "coordinates": [173.2630, -35.1115]}
    },
    {
      "type": "Feature",
      "id": "P07",
      "properties": {
