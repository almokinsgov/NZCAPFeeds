        "expected": "Name should appear"
      },
      "geometry": {"type": "Point", "coordinates": [173.2630, -35.1140]}
    },
    {
      "type": "Feature",
      "id": "P03",
      "properties": {
        "LABEL": "P03 Baseline point: LABEL",
        "test_group": "Name extraction",
        "test": "Upper-case LABEL only",
        "expected": "Name should appear"
      },
      "geometry": {"type": "Point", "coordinates": [173.2660, -35.1140]}
    },
    {
      "type": "Feature",
      "id": "P04",
